<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's own surface. On Android 12+ the radius is the launcher's
     (system_app_widget_background_radius), so zero matches its neighbours. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
