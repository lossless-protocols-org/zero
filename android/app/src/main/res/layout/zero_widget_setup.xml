<?xml version="1.0" encoding="utf-8"?>
<!-- No user yet, or a snapshot this build cannot read: one tap opens zero (which then writes a fresh one). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/ZeroWidget.Root"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_logo" />

    <TextView
        android:id="@+id/open_to_start"
        style="@style/ZeroWidget.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxLines="2"
        android:text="@string/widget_open_to_start" />
</LinearLayout>
