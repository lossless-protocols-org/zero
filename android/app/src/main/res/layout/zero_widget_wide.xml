<?xml version="1.0" encoding="utf-8"?>
<!-- One row, about 3×1 and wider: the month, today, and the add button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/ZeroWidget.Root"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_logo" />

    <LinearLayout
        android:id="@+id/figures"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/month_label"
                style="@style/ZeroWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/spent_month"
                style="@style/ZeroWidget.Figure"
                android:layout_height="30dp"
                android:autoSizeMaxTextSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/today_label"
                style="@style/ZeroWidget.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today" />

            <TextView
                android:id="@+id/spent_today"
                style="@style/ZeroWidget.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="110dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/add_expense"
        style="@style/ZeroWidget.IconTarget"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/widget_add_expense">

        <ImageView
            style="@style/ZeroWidget.IconButton"
            android:background="@drawable/widget_button_primary"
            android:src="@drawable/ic_widget_add" />
    </FrameLayout>
</LinearLayout>
