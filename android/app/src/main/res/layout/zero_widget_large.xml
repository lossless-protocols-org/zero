<?xml version="1.0" encoding="utf-8"?>
<!-- About 4×3 and up: a bigger figure, the category chips, the budget and money in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/ZeroWidget.Root"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <include layout="@layout/zero_widget_header" />

    <LinearLayout
        android:id="@+id/figures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/spent_month"
            style="@style/ZeroWidget.Figure"
            android:layout_height="48dp"
            android:autoSizeMaxTextSize="40sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/today_label"
                style="@style/ZeroWidget.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="@string/widget_today" />

            <TextView
                android:id="@+id/spent_today"
                style="@style/ZeroWidget.Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- "Add again": the latest entry entered often; opens the sheet filled in. -->
    <LinearLayout
        android:id="@+id/again_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_touch"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_on_tonal" />

        <TextView
            android:id="@+id/again_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_on_tonal"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/again_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_on_tonal"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Takes any spare height, so what follows sits at the bottom. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        layout="@layout/zero_widget_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp" />

    <include
        layout="@layout/zero_widget_budget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/income_line"
        style="@style/ZeroWidget.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />
</LinearLayout>
