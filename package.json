  "//dependencyNotes": {
    "eslint": "Pinned to ^9: eslint-plugin-react-hooks, eslint-plugin-react and @babel/eslint-parser all cap their peer range at 9, and ESLint 10 dropped .eslintrc support. See eslint.config.js.",
    "jest": "Pinned exactly to 30.3.0. Bumping to 30.4.x leaves jest-mock behind react-native's own jest chain and every suite dies with 'clearMocksOnScope is not a function'. Re-test the full suite before changing.",
    "typescript": "Held at 5.x: @typescript-eslint/eslint-plugin peers `typescript >=4.8.4 <6.0.0`, so TypeScript 7 would break linting.",
    "@babel/*": "Held at 7.x: @react-native/babel-preset 0.86.2 depends on @babel/core ^7.25.2.",
    "react-native-reanimated": "Must move in lockstep with react-native-worklets (peer: 0.10.x - 0.11.x) and peers react-native \"0.83 - 0.86\" — that peer is what caps this app at RN 0.86.x.",
    "react-native-gesture-handler": "v3 is REQUIRED by RN 0.86: v2.x imports react-native/Libraries/Renderer/shims/ReactNative, which 0.86 removed.",
    "lucide-react-native": "v1.x ships an .mjs bundle the RN jest preset resolves but jest cannot parse; jest.config.js maps it to the CJS build. All 334 icon imports in IconRegistry.ts were verified present in 1.28."
  },
  "patchedDependencies": {
    "react-native-reanimated@4.5.5": "patches/react-native-reanimated@4.5.5.patch"
  }
}
