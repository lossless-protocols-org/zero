--- a/native/ios/WatermelonDB/JSIInstaller.mm
+++ b/native/ios/WatermelonDB/JSIInstaller.mm
@@ -1,12 +1,31 @@
 #import "JSIInstaller.h"
 #import "Database.h"
+#import <React/RCTLog.h>
 
-extern "C" void installWatermelonJSI(RCTCxxBridge *bridge) {
-    if (bridge.runtime == nullptr) {
+// zero patch (RN 0.88): upstream casts the bridge to RCTCxxBridge and reads its
+// `runtime` property. React Native 0.88 removed RCTCxxBridge together with the
+// legacy bridge. In bridgeless mode the object handed to legacy modules is an
+// RCTBridgeProxy, which still implements `- (void *)runtime` (RCTBridgeProxy.mm)
+// but does not declare it in any public header. Declare the selector locally and
+// check for it before calling, so this compiles against the prebuilt 0.88 headers
+// and keeps the exact runtime path that worked on 0.86 (proxy → runtime pointer).
+@protocol WMRuntimeProvider <NSObject>
+- (void *)runtime;
+@end
+
+extern "C" void installWatermelonJSI(id bridge) {
+    if (bridge == nil || ![bridge respondsToSelector:@selector(runtime)]) {
+        RCTLogWarn(@"[WatermelonDB] bridge does not expose a JSI runtime; JSI adapter not installed");
+        return;
+    }
+
+    void *rawRuntime = [(id<WMRuntimeProvider>)bridge runtime];
+    if (rawRuntime == nullptr) {
         return;
     }
 
-    jsi::Runtime *runtime = (jsi::Runtime*) bridge.runtime;
-    assert(runtime != nullptr);
+    jsi::Runtime *runtime = (jsi::Runtime *) rawRuntime;
     watermelondb::Database::install(runtime);
+    // One line per launch so a device log proves which adapter path is live (no user data).
+    NSLog(@"[WatermelonDB] JSI adapter installed (runtime via %@)", NSStringFromClass([bridge class]));
 }
